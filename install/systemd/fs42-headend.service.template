[Unit]
Description=FieldStation42 multichannel headend (stream-copy MPEG-TS multicast)

# Installed as a systemd *user* service by install/install_services.sh (like the other FS42
# services), so: default.target rather than multi-user.target, and no AmbientCapabilities
# (a user manager can't grant them, and the unit would fail with status 218/CAPABILITIES).
# The channel workers try to renice themselves to -5 and simply stay at 0 if they can't.

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/env/bin/python3 headend.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
