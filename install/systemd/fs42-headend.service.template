[Unit]
Description=FieldStation42 multichannel headend (stream-copy MPEG-TS multicast)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/env/bin/python3 headend.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
# lets the channel workers renice themselves slightly above normal jobs
AmbientCapabilities=CAP_SYS_NICE
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
